version "7.0"
#==============================================================================
# VLC_Evaluate - VL Connector for PolyWorks: evaluates one scan (STL) by the plan of the part template.
# Used by the Measure button (VLC_Measure.pwmacro) and by the PolyWorks station. Shows no dialog.
#
#   $1 = parameters file, one KEY=value per line in this order (see docs\Protocol.md):
#         1 PWK          workspace file of the template
#         2 TEMPLATE     template project name
#         3 STL          scan to evaluate
#         4 RUN          run name (date_time), used for the piece name and the report file names
#         5 REPORT_DIR   folder for the PDF and CSV
#         6 OPERATOR     operator name (piece property)
#         7 PROGRAM      VL program file name for the CSV
#         8 UTC          measurement time (ISO 8601, UTC) for the piece date
#         9 KEEP_PIECES  All | Nok | None
#        10 COLOR_SCALE  not used since 2.0: the color map belongs to the template's plan
#        11 DEVICE       device text (piece property)
#        12 RESULT       result file to write
#        13 JOBID        job id (network scenario) or empty
#        14 APP          VL Connector app folder (for Complete-Evaluation.ps1)
#        15 STL_SHA256   SHA-256 of the STL when it was made (empty: not known, e.g. a test STL)
#   Result file (written last): STATE, VERDICT, SUMMARY, PDF, CSV, PIECE, PIECE_KEPT, MESSAGE.
#
# The template is the customer's plan; VL Connector only supplies the scan. The template has
#   - a measurement sequence (the active one, played by Play Inspection) for the alignment and the
#     measurement, without a step that acquires data itself,
#   - exactly one data object, which receives the scan,
#   - its controls (the verdict) and, optionally, a formatted report (the PDF; project property "VL report"
#     names it when the template has several).
# Every scan becomes a new piece of the template project (PIECE NEW), named <template>_<run>; the project is
# saved. A piece that is not kept (setting "Keep measured pieces") is marked "VL remove" and removed at the
# next evaluation, so it can still be reviewed in PolyWorks.
# The verdict and the CSV come from Complete-Evaluation.ps1, which is fail-closed (only PolyWorks' documented
# results inside the tolerance count as OK). Without a verdict (the plan failed, data inconsistent) the result
# is STATE=ERROR and the piece is kept.
#==============================================================================
MACRO END_ON_ERROR ( "Off" )
MACRO INTERACTIVITY ( "Off" )

DECLARE vParams $1
DECLARE vPwk ""
DECLARE vTemplate ""
DECLARE vStl ""
DECLARE vRun ""
DECLARE vReportDir ""
DECLARE vUser ""
DECLARE vProgram ""
DECLARE vUtc ""
DECLARE vKeep "All"
DECLARE vScale ""
DECLARE vDevice ""
DECLARE vResult ""
DECLARE vJobId ""
DECLARE vApp ""
DECLARE vStlHash ""
DECLARE vProj ""
DECLARE vPiece ""
DECLARE vPieceMade 0
DECLARE vFail ""
DECLARE vSt
DECLARE vErr
DECLARE vPlan ""
DECLARE vNs 0
DECLARE vType ""
DECLARE vNd 0
DECLARE vData ""
DECLARE vData2 ""
DECLARE vOptPlay ""
DECLARE vOptLink ""
DECLARE vOptReports ""
DECLARE vOptConfirm ""
DECLARE vOptUi ""
DECLARE vPieces
DECLARE vOld ""
DECLARE vRemove ""
DECLARE vProps
DECLARE vPlanSt ""
DECLARE vPlanErr ""
DECLARE vFr ""
DECLARE vNfr 0
DECLARE vPdf ""
DECLARE vCsv ""
DECLARE vRepErr ""
DECLARE vN 0
DECLARE vI 0
DECLARE vJ 0
DECLARE vObj ""
DECLARE vPass 1
DECLARE vNc 0
DECLARE vCtrls
DECLARE vNom
DECLARE vMeas
DECLARE vDev
DECLARE vUt
DECLARE vUw
DECLARE vLw
DECLARE vLt
DECLARE vRes
DECLARE vCount 0
DECLARE vSummary ""
DECLARE vVerdictAll ""
DECLARE vDetail ""
DECLARE vKept 1
DECLARE vCtl ""
DECLARE vVer ""
DECLARE vCallId
DECLARE vEState ""
DECLARE vECount ""
DECLARE vERun ""
DECLARE vEJob ""
DECLARE vECsv ""
DECLARE vEMsg ""
DECLARE vSysRoot ""
DECLARE vPs ""

DATA_FILE READ LINE_FIELD ( $vParams, 1, 2, vPwk, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 2, 2, vTemplate, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 3, 2, vStl, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 4, 2, vRun, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 5, 2, vReportDir, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 6, 2, vUser, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 7, 2, vProgram, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 8, 2, vUtc, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 9, 2, vKeep, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 10, 2, vScale, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 11, 2, vDevice, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 12, 2, vResult, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 13, 2, vJobId, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 14, 2, vApp, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 15, 2, vStlHash, "=", "On" )
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF "$vResult" == ""
    MACRO END ( "Error", "VLC_Evaluate: the parameters file $vParams could not be read." )
ENDIF
SET vPiece "${vTemplate}_${vRun}"
SET vPdf "${vReportDir}\${vPiece}.pdf"
SET vCsv "${vReportDir}\${vPiece}.csv"
SYSTEM COMMAND EXEC SYNC ( "IF", { "NOT", "EXIST", "${_QUOTES}${vReportDir}${_QUOTES}", "MKDIR", "${_QUOTES}${vReportDir}${_QUOTES}" } )

# --- 1) the template project ------------------------------------------------------------------------
PROJECT PROPERTIES NAME GET ( vProj )
IF "$vProj" != "$vTemplate"
    FILE OPEN_PROJECT_IN_PWK ( $vPwk, $vTemplate )
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF $vSt == "Error"
        SET vFail "The template $vTemplate could not be opened: $vErr"
    ENDIF
ENDIF

# --- 2) the plan: the active measurement sequence, and the data object it measures ------------------
IF "$vFail" == ""
    SEQUENCE ACTIVE GET ( vPlan )
    SET vNs 0
    IF "$vPlan" != ""
        SEQUENCE STEP COUNT GET ( $vPlan, vNs )
    ENDIF
    IF $vNs < 1
        SET vFail "The template $vTemplate has no measurement plan. VL Connector measures with the template's own measurement sequence (Play Inspection): create one in PolyWorks (Sequence Editor, for example from the autogenerated sequence), remove its step that acquires the data object, and save the template."
    ENDIF
ENDIF
IF "$vFail" == ""
    SET vI 1
    WHILE $vI <= $vNs
        SET vType ""
        SEQUENCE STEP TYPE GET ( $vPlan, $vI, vType )
        IF "$vType" == "Data Object"
            SET vFail "The measurement sequence $vPlan of the template $vTemplate acquires data itself (step $vI). VL Connector supplies the scan: remove that step in the Sequence Editor and save the template."
            SET vI $vNs
        ENDIF
        ++ vI
    ENDWHILE
ENDIF
IF "$vFail" == ""
    TREEVIEW DATA COUNT GET ( vNd )
    IF $vNd != 1
        SET vFail "The template $vTemplate must have exactly one data object, which receives the scan; it has $vNd."
    ELSE
        TREEVIEW DATA NAME GET ( 1, vData )
    ENDIF
ENDIF

# --- 3) the new piece -------------------------------------------------------------------------------
# PolyWorks asks about these on a new piece unless they are set; the user's choices are restored at once
IF "$vFail" == ""
    PIECE NEW OPTIONS LAUNCH_PLAY_INSPECTION GET ( vOptPlay )
    PIECE NEW OPTIONS LINK_TO_PIECE_TEMPLATE GET ( vOptLink )
    PIECE NEW OPTIONS NON_UPDATABLE_REPORTS GET ( vOptReports )
    PIECE NEW OPTIONS LAUNCH_PLAY_INSPECTION ( "No" )
    PIECE NEW OPTIONS LINK_TO_PIECE_TEMPLATE ( "No" )
    PIECE NEW OPTIONS NON_UPDATABLE_REPORTS ( "Keep" )
    PIECE NEW ( $vPiece )
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF "$vOptPlay" != ""
        PIECE NEW OPTIONS LAUNCH_PLAY_INSPECTION ( $vOptPlay )
    ENDIF
    IF "$vOptLink" != ""
        PIECE NEW OPTIONS LINK_TO_PIECE_TEMPLATE ( $vOptLink )
    ENDIF
    IF "$vOptReports" != ""
        PIECE NEW OPTIONS NON_UPDATABLE_REPORTS ( $vOptReports )
    ENDIF
    IF $vSt == "Error"
        SET vFail "The piece $vPiece could not be added to $vTemplate: $vErr"
    ELSE
        SET vPieceMade 1
    ENDIF
ENDIF
IF "$vFail" == ""
    # a new piece takes over the customizable properties of the piece it is made from, also the mark of a
    # piece that is not kept: the new piece starts without it
    PIECE PROPERTIES CUSTOMIZABLE NAME ALL GET ( , vProps )
    SET vI 1
    WHILE $vI <= SIZE(vProps)
        IF "$vProps[$vI]" == "VL remove"
            PIECE PROPERTIES CUSTOMIZABLE REMOVE ( , { "VL remove" } )
        ENDIF
        ++ vI
    ENDWHILE
    # pieces the previous evaluations did not keep
    PIECE NAME ALL GET ( vPieces )
    SET vI 1
    WHILE $vI <= SIZE(vPieces)
        SET vOld $vPieces[$vI]
        ++ vI
        IF "$vOld" != "$vPiece"
            SET vRemove ""
            PIECE PROPERTIES CUSTOMIZABLE GET ( $vOld, "VL remove", vRemove )
            IF "$vRemove" == "1"
                PIECE DELETE ( { $vOld } )
            ENDIF
        ENDIF
    ENDWHILE
    # report header: measurement date and time, serial number, operator, device
    IF "$vUtc" != ""
        PIECE PROPERTIES DATE_TIME_UTC ( , $vUtc )
    ENDIF
    PIECE PROPERTIES CUSTOMIZABLE ( , { "Serial number", "Operator name", "Device" }, { $vPiece, $vUser, $vDevice } )
ENDIF

# --- 4) the scan replaces the data of the plan's data object ----------------------------------------
IF "$vFail" == ""
    DATA REPLACE OPTIONS ALIGNMENT_GROUP CONFIRM_AT_REPLACEMENT GET ( vOptConfirm )
    DATA REPLACE OPTIONS ALIGNMENT_GROUP CONFIRM_AT_REPLACEMENT ( "Off" )
    FILE IMPORT_DATA POLYGONAL_MODEL ( { $vStl }, "stl", $vData )
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF "$vOptConfirm" != ""
        DATA REPLACE OPTIONS ALIGNMENT_GROUP CONFIRM_AT_REPLACEMENT ( $vOptConfirm )
    ENDIF
    IF $vSt == "Error"
        SET vFail "The STL could not be imported into the data object $vData: $vErr"
    ELSE
        # the replaced object takes the name of the file; the plan knows it by its own name
        TREEVIEW DATA NAME GET ( 1, vData2 )
        IF "$vData2" != "$vData"
            TREEVIEW OBJECT PROPERTIES NAME ( $vData, { $vData2 } )
        ENDIF
    ENDIF
ENDIF

# --- 5) the plan: alignment and measurement as the template defines them ----------------------------
IF "$vFail" == ""
    PIECE PLAY_INSPECTION OPTIONS DISABLE_INTERFACE GET ( vOptUi )
    PIECE PLAY_INSPECTION OPTIONS DISABLE_INTERFACE ( "On" )
    PIECE PLAY_INSPECTION
    MACRO GET_ERROR_STATUS ( vPlanSt, vPlanErr )
    IF "$vOptUi" != ""
        PIECE PLAY_INSPECTION OPTIONS DISABLE_INTERFACE ( $vOptUi )
    ENDIF
    TREEVIEW OBJECT SELECT NONE
ENDIF

# --- no plan or no piece: an error result, no verdict ------------------------------------------------
IF "$vFail" != ""
    IF $vPieceMade == 1
        FILE SAVE_PROJECT
    ELSE
        SET vPiece ""
    ENDIF
    DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
    DATA_FILE APPEND LINE ( $vResult, { "STATE=ERROR" } )
    DATA_FILE APPEND LINE ( $vResult, { "VERDICT=" } )
    DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PDF=" } )
    DATA_FILE APPEND LINE ( $vResult, { "CSV=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE=$vPiece" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=$vPieceMade" } )
    DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=$vFail" } )
    MACRO END ( "Error", "VLC_Evaluate" )
ENDIF

# --- 6) verdict: the raw control data -> Complete-Evaluation.ps1 (verdict and CSV) ------------------
# Windows PowerShell by its full path, never a powershell.exe found first on the search path
SYSTEM ENVIRONMENT_VARIABLE GET ( "SystemRoot", vSysRoot )
SET vPs "${vSysRoot}\System32\WindowsPowerShell\v1.0\powershell.exe"
SET vCtl "${vResult}.controls"
SET vVer "${vResult}.verdict"
DATA_FILE CREATE ( $vCtl, "Unicode", "Yes" )
DATA_FILE APPEND LINE ( $vCtl, { "FORMAT=VLC-CONTROLS-2" } )
DATA_FILE APPEND LINE ( $vCtl, { "RUN=$vRun" } )
DATA_FILE APPEND LINE ( $vCtl, { "JOBID=$vJobId" } )
DATA_FILE APPEND LINE ( $vCtl, { "PIECE=$vPiece" } )
DATA_FILE APPEND LINE ( $vCtl, { "TEMPLATE=$vTemplate" } )
DATA_FILE APPEND LINE ( $vCtl, { "PROGRAM=$vProgram" } )
DATA_FILE APPEND LINE ( $vCtl, { "OPERATOR=$vUser" } )
DATA_FILE APPEND LINE ( $vCtl, { "STL=$vStl" } )
DATA_FILE APPEND LINE ( $vCtl, { "STL_SHA256=$vStlHash" } )
DATA_FILE APPEND LINE ( $vCtl, { "REPORT_DIR=$vReportDir" } )
DATA_FILE APPEND LINE ( $vCtl, { "CSV=$vCsv" } )
DATA_FILE APPEND LINE ( $vCtl, { "PLAN=$vPlan" } )
DATA_FILE APPEND LINE ( $vCtl, { "PLAN_STATUS=$vPlanSt" } )
DATA_FILE APPEND LINE ( $vCtl, { "PLAN_ERROR=$vPlanErr" } )
# pass 1 = features, pass 2 = comparison points; objects without controls (e.g. datums) are skipped
SET vPass 1
WHILE $vPass <= 2
  IF $vPass == 1
    TREEVIEW FEATURE COUNT GET ( vN )
  ELSE
    TREEVIEW COMPARISON_POINT COUNT GET ( vN )
  ENDIF
  SET vI 1
  WHILE $vI <= $vN
    IF $vPass == 1
        TREEVIEW FEATURE NAME GET ( $vI, vObj )
    ELSE
        TREEVIEW COMPARISON_POINT NAME GET ( $vI, vObj )
    ENDIF
    ++ vI
    SET vNc 0
    MEASURE CONTROL COUNT GET ( vNc, { $vObj } )
    IF $vNc > 0
      MEASURE CONTROL NAME ALL GET ( vCtrls, $vObj )
    ENDIF
    SET vJ 1
    WHILE $vJ <= $vNc
        IF "$vCtrls[$vJ]" != ""
            SET vNom ""
            SET vMeas ""
            SET vDev ""
            SET vUt ""
            SET vLt ""
            SET vRes ""
            MEASURE CONTROL NOMINAL GET ( $vCtrls[$vJ], vNom, $vObj )
            MEASURE CONTROL MEASURED GET ( $vCtrls[$vJ], vMeas, $vObj )
            MEASURE CONTROL DEVIATION GET ( $vCtrls[$vJ], vDev, $vObj )
            MEASURE CONTROL TOLERANCE_ZONE LIMITS GET ( $vCtrls[$vJ], vUt, vUw, vLw, vLt, $vObj )
            MEASURE CONTROL TEST TOLERANCE_ZONE_RESULT GET ( $vCtrls[$vJ], vRes, $vObj )
            ++ vCount
            DATA_FILE APPEND LINE ( $vCtl, { "CONTROL=$vObj" } )
            DATA_FILE APPEND LINE ( $vCtl, { "NAME=$vCtrls[$vJ]" } )
            DATA_FILE APPEND LINE ( $vCtl, { "NOMINAL=$vNom" } )
            DATA_FILE APPEND LINE ( $vCtl, { "MEASURED=$vMeas" } )
            DATA_FILE APPEND LINE ( $vCtl, { "DEVIATION=$vDev" } )
            DATA_FILE APPEND LINE ( $vCtl, { "UPPER_TOL=$vUt" } )
            DATA_FILE APPEND LINE ( $vCtl, { "UPPER_WARN=$vUw" } )
            DATA_FILE APPEND LINE ( $vCtl, { "LOWER_WARN=$vLw" } )
            DATA_FILE APPEND LINE ( $vCtl, { "LOWER_TOL=$vLt" } )
            DATA_FILE APPEND LINE ( $vCtl, { "RESULT=$vRes" } )
        ENDIF
        ++ vJ
    ENDWHILE
  ENDWHILE
  ++ vPass
ENDWHILE
DATA_FILE APPEND LINE ( $vCtl, { "END=$vCount" } )
# the verdict file is emptied first: a verdict of an earlier piece can never be read
DATA_FILE CREATE ( $vVer, "Ascii", "Yes" )
SYSTEM COMMAND EXEC SYNC ( $vPs, { "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-WindowStyle", "Hidden", "-File", "${_QUOTES}${vApp}\polyworks\Complete-Evaluation.ps1${_QUOTES}", "-Controls", "${_QUOTES}${vCtl}${_QUOTES}", "-Out", "${_QUOTES}${vVer}${_QUOTES}" }, vCallId )
DATA_FILE READ LINE_FIELD ( $vVer, 1, 2, vEState, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 2, 2, vVerdictAll, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 3, 2, vDetail, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 4, 2, vECount, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 5, 2, vERun, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 6, 2, vEJob, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 7, 2, vECsv, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 8, 2, vEMsg, "=", "On" )
SYSTEM COMMAND EXEC SYNC ( "DEL", { "/Q", "${_QUOTES}${vCtl}${_QUOTES}", "${_QUOTES}${vVer}${_QUOTES}" } )
# the verdict must be the one of this piece
IF "$vEState" == "OK"
    IF "$vERun" != "$vRun" OR "$vEJob" != "$vJobId" OR "$vECount" != "$vCount"
        SET vEState "ERROR"
        SET vEMsg "The verdict does not belong to this piece (run $vERun, job $vEJob, $vECount controls)."
    ENDIF
ENDIF
IF "$vEState" != "OK"
    IF "$vEMsg" == ""
        SET vEMsg "PowerShell could not run ${vApp}\polyworks\Complete-Evaluation.ps1."
    ENDIF
    # no verdict: the piece is kept for checking
    FILE SAVE_PROJECT
    DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
    DATA_FILE APPEND LINE ( $vResult, { "STATE=ERROR" } )
    DATA_FILE APPEND LINE ( $vResult, { "VERDICT=" } )
    DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PDF=" } )
    DATA_FILE APPEND LINE ( $vResult, { "CSV=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE=$vPiece" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=1" } )
    DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=$vEMsg (No verdict; the piece $vPiece is kept for checking.)" } )
    MACRO END ( "Error", "Verdict" )
ENDIF
SET vSummary "$vVerdictAll - $vDetail"

# --- 7) PDF: the template's own formatted report, updated by the plan -------------------------------
# VL Connector builds no report of its own; without a formatted report in the template there is no PDF.
PROJECT PROPERTIES CUSTOMIZABLE GET ( "VL report", vFr )
TREEVIEW FORMATTED_REPORT COUNT GET ( vNfr )
IF "$vFr" == "" AND $vNfr > 0
    TREEVIEW FORMATTED_REPORT NAME GET ( 1, vFr )
ENDIF
IF "$vFr" != ""
    FILE EXPORT_FORMATTED_REPORT PDF ( $vPdf, "Off", $vFr )
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF $vSt == "Error"
        SET vRepErr "The report $vFr could not be exported to PDF: $vErr"
        SET vPdf ""
    ENDIF
ELSE
    SET vRepErr "The template has no formatted report, so there is no PDF."
    SET vPdf ""
ENDIF

# --- 8) keep the piece or mark it for removal at the next evaluation --------------------------------
# All: always; Nok: only NOK pieces; None: never
SET vKept 1
IF "$vKeep" == "None"
    SET vKept 0
ENDIF
IF "$vKeep" == "Nok" AND "$vVerdictAll" == "OK"
    SET vKept 0
ENDIF
IF $vKept == 0
    PIECE PROPERTIES CUSTOMIZABLE ADD ( , { "VL remove" }, { "1" } )
ENDIF
FILE SAVE_PROJECT
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF $vSt == "Error"
    SET vRepErr "The template project could not be saved: $vErr"
ENDIF

# --- 9) result for the caller -----------------------------------------------------------------------
DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
DATA_FILE APPEND LINE ( $vResult, { "STATE=OK" } )
DATA_FILE APPEND LINE ( $vResult, { "VERDICT=$vVerdictAll" } )
DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=$vDetail" } )
DATA_FILE APPEND LINE ( $vResult, { "PDF=$vPdf" } )
DATA_FILE APPEND LINE ( $vResult, { "CSV=$vECsv" } )
DATA_FILE APPEND LINE ( $vResult, { "PIECE=$vPiece" } )
DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=$vKept" } )
DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=$vRepErr" } )
MACRO ECHO ( "VLC_Evaluate: $vPiece: $vSummary. Report $vPdf" )
