version "7.0"
#==============================================================================
# VLC_Evaluate - VL Connector for PolyWorks: evaluates one scan (STL) against a part template.
# Used by the Measure button (VLC_Measure.pwmacro) and by the PolyWorks station. Shows no dialog.
#
#   $1 = parameters file, one KEY=value per line in this order (see docs\Protocol.md):
#         1 PWK          workspace file of the template
#         2 TEMPLATE     template project name
#         3 STL          scan to evaluate
#         4 RUN          run name (date_time), used for the piece name and the report file names
#         5 REPORT_DIR   folder for the PDF and CSV
#         6 OPERATOR     operator name for the report
#         7 PROGRAM      VL program file name for the CSV
#         8 UTC          measurement time (ISO 8601, UTC) for the piece date
#         9 KEEP_PIECES  All | Nok | None
#        10 COLOR_SCALE  color map range in mm (e.g. 0.5)
#        11 DEVICE       device text for the report
#        12 RESULT       result file to write
#        13 JOBID        job id (network scenario) or empty
#        14 APP          VL Connector app folder (for Complete-Evaluation.ps1)
#        15 STL_SHA256   SHA-256 of the STL when it was made (empty: not known, e.g. a test STL)
#   Result file (written last): STATE, VERDICT, SUMMARY, PDF, CSV, PIECE, PIECE_KEPT, MESSAGE.
#
# The measured piece is a copy of the template (<template>_<run>), made before anything is changed:
# PolyWorks writes piece and project properties to the workspace immediately, so they must never be
# set in the template. The template itself is never saved.
# This macro only measures and collects: the verdict and the CSV come from Complete-Evaluation.ps1, which
# is fail-closed (only PolyWorks' documented results inside the tolerance count as OK). Without a verdict
# (alignment or measurement failed, data inconsistent) the result is STATE=ERROR and the piece is kept.
#==============================================================================
MACRO END_ON_ERROR ( "Off" )
MACRO INTERACTIVITY ( "Off" )

DECLARE vParams $1
DECLARE vPwk ""
DECLARE vTemplate ""
DECLARE vStl ""
DECLARE vRun ""
DECLARE vReportDir ""
DECLARE vUser ""
DECLARE vProgram ""
DECLARE vUtc ""
DECLARE vKeep "All"
DECLARE vScale 0.5
DECLARE vDevice ""
DECLARE vResult ""
DECLARE vJobId ""
DECLARE vProj ""
DECLARE vPiece ""
DECLARE vSt
DECLARE vErr
DECLARE vData
DECLARE vFr ""
DECLARE vPdf ""
DECLARE vCsv ""
DECLARE vN 0
DECLARE vI 0
DECLARE vJ 0
DECLARE vObj ""
DECLARE vPass 1
DECLARE vNc 0
DECLARE vCtrls
DECLARE vNom
DECLARE vMeas
DECLARE vDev
DECLARE vUt
DECLARE vUw
DECLARE vLw
DECLARE vLt
DECLARE vRes
DECLARE vCount 0
DECLARE vSummary ""
DECLARE vVerdictAll ""
DECLARE vDetail ""
DECLARE vNfr 0
DECLARE vRepErr ""
DECLARE vDest ""
DECLARE vKept 1
DECLARE vNegScale -0.5
DECLARE vApp ""
DECLARE vStlHash ""
DECLARE vAlignSt ""
DECLARE vAlignErr ""
DECLARE vExtractSt ""
DECLARE vExtractErr ""
DECLARE vNf 0
DECLARE vNcp 0
DECLARE vCtl ""
DECLARE vVer ""
DECLARE vCallId
DECLARE vEState ""
DECLARE vECount ""
DECLARE vERun ""
DECLARE vEJob ""
DECLARE vECsv ""
DECLARE vEMsg ""

DATA_FILE READ LINE_FIELD ( $vParams, 1, 2, vPwk, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 2, 2, vTemplate, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 3, 2, vStl, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 4, 2, vRun, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 5, 2, vReportDir, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 6, 2, vUser, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 7, 2, vProgram, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 8, 2, vUtc, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 9, 2, vKeep, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 10, 2, vScale, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 11, 2, vDevice, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 12, 2, vResult, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 13, 2, vJobId, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 14, 2, vApp, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 15, 2, vStlHash, "=", "On" )
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF "$vResult" == ""
    MACRO END ( "Error", "VLC_Evaluate: the parameters file $vParams could not be read." )
ENDIF
SET vPiece "${vTemplate}_${vRun}"
SET vPdf "${vReportDir}\${vPiece}.pdf"
SET vCsv "${vReportDir}\${vPiece}.csv"
SET vNegScale EXPR ( -$vScale )
SYSTEM COMMAND EXEC SYNC ( "IF", { "NOT", "EXIST", "${_QUOTES}${vReportDir}${_QUOTES}", "MKDIR", "${_QUOTES}${vReportDir}${_QUOTES}" } )

# --- 1) clean template --------------------------------------------------------------
PROJECT PROPERTIES NAME GET ( vProj )
IF "$vProj" != "$vTemplate"
    FILE OPEN_PROJECT_IN_PWK ( $vPwk, $vTemplate )
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF $vSt == "Error"
        DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
        DATA_FILE APPEND LINE ( $vResult, { "STATE=ERROR" } )
        DATA_FILE APPEND LINE ( $vResult, { "VERDICT=" } )
        DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=" } )
        DATA_FILE APPEND LINE ( $vResult, { "PDF=" } )
        DATA_FILE APPEND LINE ( $vResult, { "CSV=" } )
        DATA_FILE APPEND LINE ( $vResult, { "PIECE=" } )
        DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=0" } )
        DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=The template $vTemplate could not be opened: $vErr" } )
        MACRO END ( "Error", "Template" )
    ENDIF
ENDIF

# --- 2) piece = copy of the template ----------------------------------------------------
FILE SAVE_PROJECT_AS ( $vPwk, $vPiece )
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF $vSt == "Error"
    DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
    DATA_FILE APPEND LINE ( $vResult, { "STATE=ERROR" } )
    DATA_FILE APPEND LINE ( $vResult, { "VERDICT=" } )
    DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PDF=" } )
    DATA_FILE APPEND LINE ( $vResult, { "CSV=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=0" } )
    DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=The piece $vPiece could not be created: $vErr" } )
    MACRO END ( "Error", "Piece" )
ENDIF
# the measured piece remembers its template (the next press of the Measure button opens it)
PROJECT PROPERTIES CUSTOMIZABLE ( "VL template", $vTemplate )
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF $vSt == "Error"
    PROJECT PROPERTIES CUSTOMIZABLE ADD ( "VL template", $vTemplate )
ENDIF

# --- 3) data, alignment to CAD, measurement ------------------------------------------------
FILE IMPORT_DATA POLYGONAL_MODEL ( { $vStl }, "stl" )
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF $vSt == "Error"
    DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
    DATA_FILE APPEND LINE ( $vResult, { "STATE=ERROR" } )
    DATA_FILE APPEND LINE ( $vResult, { "VERDICT=" } )
    DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PDF=" } )
    DATA_FILE APPEND LINE ( $vResult, { "CSV=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE=$vPiece" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=0" } )
    DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=The STL could not be imported: $vErr" } )
    MACRO END ( "Error", "STL import" )
ENDIF
TREEVIEW DATA NAME GET ( 1, vData )
TREEVIEW OBJECT PROPERTIES NAME ( "Scan", { $vData } )

TREEVIEW OBJECT SELECT NONE
ALIGN BEST_FIT DATA_TO_REFERENCE CREATE FIT_TO_REFERENCE_OBJECT_SURFACES USING_PRE_ALIGNMENT AUTOMATIC ( "Best-fit to CAD" )
MACRO GET_ERROR_STATUS ( vAlignSt, vAlignErr )
# a failed measurement could leave values of the template in place: its error means no verdict
TREEVIEW FEATURE COUNT GET ( vNf )
TREEVIEW COMPARISON_POINT COUNT GET ( vNcp )
IF $vNf > 0
    TREEVIEW OBJECT SELECT NONE
    TREEVIEW FEATURE SELECT ALL
    MEASURE EXTRACT MEASURED
    MACRO GET_ERROR_STATUS ( vExtractSt, vExtractErr )
ENDIF
IF $vNcp > 0
    TREEVIEW OBJECT SELECT NONE
    MEASURE COMPARISON_POINT EXTRACT MEASURED ALL
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF "$vSt" == "Error" AND "$vExtractSt" != "Error"
        SET vExtractSt $vSt
        SET vExtractErr $vErr
    ENDIF
ENDIF
TREEVIEW OBJECT SELECT NONE
COMPARE VIEWING_OPTIONS COLOR_SCALE RANGE_LIMITS ( "Custom", $vNegScale, $vScale )
COMPARE VIEWING_OPTIONS COLOR_SCALE SYMMETRICAL ( "On" )
MEASURE DATA_COLOR_MAP REFERENCE_SURFACE CREATE ( "Deviation from CAD" )

# --- 4) report header: piece properties (name, measurement date and time, operator) --
PIECE PROPERTIES NAME ( , $vRun )
IF "$vUtc" != ""
    PIECE PROPERTIES DATE_TIME_UTC ( , $vUtc )
ENDIF
PIECE PROPERTIES CUSTOMIZABLE ( , { "Serial number", "Operator name", "Device" }, { $vPiece, $vUser, $vDevice } )

# --- 5) verdict: the raw control data -> Complete-Evaluation.ps1 (verdict and CSV) --------
SET vCtl "${vResult}.controls"
SET vVer "${vResult}.verdict"
DATA_FILE CREATE ( $vCtl, "Unicode", "Yes" )
DATA_FILE APPEND LINE ( $vCtl, { "FORMAT=VLC-CONTROLS-1" } )
DATA_FILE APPEND LINE ( $vCtl, { "RUN=$vRun" } )
DATA_FILE APPEND LINE ( $vCtl, { "JOBID=$vJobId" } )
DATA_FILE APPEND LINE ( $vCtl, { "PIECE=$vPiece" } )
DATA_FILE APPEND LINE ( $vCtl, { "TEMPLATE=$vTemplate" } )
DATA_FILE APPEND LINE ( $vCtl, { "PROGRAM=$vProgram" } )
DATA_FILE APPEND LINE ( $vCtl, { "OPERATOR=$vUser" } )
DATA_FILE APPEND LINE ( $vCtl, { "STL=$vStl" } )
DATA_FILE APPEND LINE ( $vCtl, { "STL_SHA256=$vStlHash" } )
DATA_FILE APPEND LINE ( $vCtl, { "REPORT_DIR=$vReportDir" } )
DATA_FILE APPEND LINE ( $vCtl, { "CSV=$vCsv" } )
DATA_FILE APPEND LINE ( $vCtl, { "ALIGN_STATUS=$vAlignSt" } )
DATA_FILE APPEND LINE ( $vCtl, { "ALIGN_ERROR=$vAlignErr" } )
DATA_FILE APPEND LINE ( $vCtl, { "EXTRACT_STATUS=$vExtractSt" } )
DATA_FILE APPEND LINE ( $vCtl, { "EXTRACT_ERROR=$vExtractErr" } )
# pass 1 = features, pass 2 = comparison points; objects without controls (e.g. axes for a pitch) are skipped
SET vPass 1
WHILE $vPass <= 2
  IF $vPass == 1
    TREEVIEW FEATURE COUNT GET ( vN )
  ELSE
    TREEVIEW COMPARISON_POINT COUNT GET ( vN )
  ENDIF
  SET vI 1
  WHILE $vI <= $vN
    IF $vPass == 1
        TREEVIEW FEATURE NAME GET ( $vI, vObj )
    ELSE
        TREEVIEW COMPARISON_POINT NAME GET ( $vI, vObj )
    ENDIF
    ++ vI
    SET vNc 0
    MEASURE CONTROL COUNT GET ( vNc, { $vObj } )
    IF $vNc > 0
      MEASURE CONTROL NAME ALL GET ( vCtrls, $vObj )
    ENDIF
    SET vJ 1
    WHILE $vJ <= $vNc
        IF "$vCtrls[$vJ]" != ""
            SET vNom ""
            SET vMeas ""
            SET vDev ""
            SET vUt ""
            SET vLt ""
            SET vRes ""
            MEASURE CONTROL NOMINAL GET ( $vCtrls[$vJ], vNom, $vObj )
            MEASURE CONTROL MEASURED GET ( $vCtrls[$vJ], vMeas, $vObj )
            MEASURE CONTROL DEVIATION GET ( $vCtrls[$vJ], vDev, $vObj )
            MEASURE CONTROL TOLERANCE_ZONE LIMITS GET ( $vCtrls[$vJ], vUt, vUw, vLw, vLt, $vObj )
            MEASURE CONTROL TEST TOLERANCE_ZONE_RESULT GET ( $vCtrls[$vJ], vRes, $vObj )
            ++ vCount
            DATA_FILE APPEND LINE ( $vCtl, { "CONTROL=$vObj" } )
            DATA_FILE APPEND LINE ( $vCtl, { "NAME=$vCtrls[$vJ]" } )
            DATA_FILE APPEND LINE ( $vCtl, { "NOMINAL=$vNom" } )
            DATA_FILE APPEND LINE ( $vCtl, { "MEASURED=$vMeas" } )
            DATA_FILE APPEND LINE ( $vCtl, { "DEVIATION=$vDev" } )
            DATA_FILE APPEND LINE ( $vCtl, { "UPPER_TOL=$vUt" } )
            DATA_FILE APPEND LINE ( $vCtl, { "UPPER_WARN=$vUw" } )
            DATA_FILE APPEND LINE ( $vCtl, { "LOWER_WARN=$vLw" } )
            DATA_FILE APPEND LINE ( $vCtl, { "LOWER_TOL=$vLt" } )
            DATA_FILE APPEND LINE ( $vCtl, { "RESULT=$vRes" } )
        ENDIF
        ++ vJ
    ENDWHILE
  ENDWHILE
  ++ vPass
ENDWHILE
DATA_FILE APPEND LINE ( $vCtl, { "END=$vCount" } )
# the verdict file is emptied first: a verdict of an earlier piece can never be read
DATA_FILE CREATE ( $vVer, "Ascii", "Yes" )
SYSTEM COMMAND EXEC SYNC ( "powershell.exe", { "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-WindowStyle", "Hidden", "-File", "${_QUOTES}${vApp}\polyworks\Complete-Evaluation.ps1${_QUOTES}", "-Controls", "${_QUOTES}${vCtl}${_QUOTES}", "-Out", "${_QUOTES}${vVer}${_QUOTES}" }, vCallId )
DATA_FILE READ LINE_FIELD ( $vVer, 1, 2, vEState, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 2, 2, vVerdictAll, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 3, 2, vDetail, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 4, 2, vECount, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 5, 2, vERun, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 6, 2, vEJob, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 7, 2, vECsv, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vVer, 8, 2, vEMsg, "=", "On" )
SYSTEM COMMAND EXEC SYNC ( "DEL", { "/Q", "${_QUOTES}${vCtl}${_QUOTES}", "${_QUOTES}${vVer}${_QUOTES}" } )
# the verdict must be the one of this piece
IF "$vEState" == "OK"
    IF "$vERun" != "$vRun" OR "$vEJob" != "$vJobId" OR "$vECount" != "$vCount"
        SET vEState "ERROR"
        SET vEMsg "The verdict does not belong to this piece (run $vERun, job $vEJob, $vECount controls)."
    ENDIF
ENDIF
IF "$vEState" != "OK"
    IF "$vEMsg" == ""
        SET vEMsg "PowerShell could not run ${vApp}\polyworks\Complete-Evaluation.ps1."
    ENDIF
    # no verdict: the piece is kept for checking
    FILE SAVE_PROJECT
    DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
    DATA_FILE APPEND LINE ( $vResult, { "STATE=ERROR" } )
    DATA_FILE APPEND LINE ( $vResult, { "VERDICT=" } )
    DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PDF=" } )
    DATA_FILE APPEND LINE ( $vResult, { "CSV=" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE=$vPiece" } )
    DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=1" } )
    DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=$vEMsg (No verdict; the piece $vPiece is kept for checking.)" } )
    MACRO END ( "Error", "Verdict" )
ENDIF
SET vSummary "$vVerdictAll - $vDetail"

# --- 6) PDF report --------------------------------------------------------------
# PolyWorks' own report layout: control snapshot and table, then top and front views of the color map.
# New report items go to the tree view temporarily (the default destination "Active Formatted
# Report" would put them into an automatically created "report 1"); the report is then built from
# them. Without a selection, CREATE_AUTOMATIC takes all items except the header and footer
# (SELECT ALL would select only those two).
REPORT_ITEM OPTIONS DESTINATION GET ( vDest )
REPORT_ITEM OPTIONS DESTINATION ( "Tree View" )
MEASURE CONTROL_VIEW CREATE FROM_ALL_CONTROLS ( "Controls", "Dimensions and points with tolerances" )
MEASURE CONTROL_VIEW REPORT_ITEM CREATE SNAPSHOT_AND_TABLE ( { "Controls" } )
VIEW POSE Z_POS
VIEW POSE CENTER
REPORT_ITEM SNAPSHOT CAPTURE ( "Deviation color map - top" )
VIEW POSE Y_NEG
VIEW POSE CENTER
REPORT_ITEM SNAPSHOT CAPTURE ( "Deviation color map - front" )
VIEW POSE ISOMETRIC ( "+X-Y+Z", "+Z" )
VIEW POSE CENTER
TREEVIEW OBJECT SELECT NONE
TREEVIEW REPORT_ITEM SELECT NONE
FORMATTED_REPORT CREATE_AUTOMATIC ( "Report" )
TREEVIEW FORMATTED_REPORT COUNT GET ( vNfr )
TREEVIEW FORMATTED_REPORT NAME GET ( $vNfr, vFr )
FORMATTED_REPORT PROPERTIES STANDARD ( $vFr, "Title", "Inspection Report - $vTemplate" )
FORMATTED_REPORT PROPERTIES STANDARD ( $vFr, "Author", $vUser )
FILE EXPORT_FORMATTED_REPORT PDF ( $vPdf, "Off", $vFr )
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF $vSt == "Error"
    SET vRepErr "PDF export: $vErr"
ENDIF
IF "$vDest" != ""
    REPORT_ITEM OPTIONS DESTINATION ( $vDest )
ENDIF

# --- 7) keep the piece ------------------------------------------------------------
# All: always; Nok: only NOK pieces; None: never (the caller removes the piece project from the workspace)
SET vKept 1
IF "$vKeep" == "None"
    SET vKept 0
ENDIF
IF "$vKeep" == "Nok" AND "$vVerdictAll" == "OK"
    SET vKept 0
ENDIF
IF $vKept == 1
    FILE SAVE_PROJECT
ENDIF

# --- 8) result for the caller ---------------------------------------------------------
DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
DATA_FILE APPEND LINE ( $vResult, { "STATE=OK" } )
DATA_FILE APPEND LINE ( $vResult, { "VERDICT=$vVerdictAll" } )
DATA_FILE APPEND LINE ( $vResult, { "SUMMARY=$vDetail" } )
DATA_FILE APPEND LINE ( $vResult, { "PDF=$vPdf" } )
DATA_FILE APPEND LINE ( $vResult, { "CSV=$vECsv" } )
DATA_FILE APPEND LINE ( $vResult, { "PIECE=$vPiece" } )
DATA_FILE APPEND LINE ( $vResult, { "PIECE_KEPT=$vKept" } )
DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=$vRepErr" } )
MACRO ECHO ( "VLC_Evaluate: $vPiece: $vSummary. Report $vPdf" )
