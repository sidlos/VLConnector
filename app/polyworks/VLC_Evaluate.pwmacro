version "7.0"
#==============================================================================
# VLC_Evaluate - VL Connector for PolyWorks: measures one scan (STL) by the plan of the part template.
# Used by the Measure button (VLC_Measure.pwmacro) and by the PolyWorks station. Shows no dialog.
#
#   $1 = parameters file, one KEY=value per line in this order (see docs\Protocol.md):
#         1 PWK          workspace file of the template
#         2 TEMPLATE     template project name
#         3 STL          scan to measure
#         4 RUN          run name (date_time), used for the piece name and the PDF file name
#         5 REPORT_DIR   folder for the PDF
#         6 OPERATOR     operator name (piece property)
#         7 UTC          measurement time (ISO 8601, UTC) for the piece date
#         8 DEVICE       device text (piece property)
#         9 RESULT       result file to write
#        10 JOBID        job id (network scenario) or empty
#        11 APP          VL Connector app folder (for Test-ScanFile.ps1)
#        12 STL_SHA256   SHA-256 of the STL when it was made (empty: not known, e.g. a test STL)
#   Result file (written last): STATE (OK: the plan was played; ERROR: something went wrong), PDF, PIECE, MESSAGE.
#
# The template is the customer's plan, and PolyWorks judges the part: VL Connector supplies the scan, plays the
# plan and exports the template's report; it reads no controls and gives no verdict of its own. The template has
#   - a measurement sequence (the active one, played by Play Inspection) for the alignment and the
#     measurement, without a step that acquires data itself (removed or ignored),
#   - exactly one data object, which receives the scan,
#   - optionally a formatted report (the PDF; project property "VL report" names it when there are several),
#   - recommended by PolyWorks: a piece template made from the first inspected piece (project property
#     "VL piece template" names it when there are several).
# Every scan becomes a new piece of the template project (PIECE NEW), named <template>_<run>: made from the
# piece template and linked to it, or, without a piece template, from the open piece. Each piece holds its own
# copy of the plan; a new piece starts without data and measurements. The piece is always kept, and the project
# is saved.
#==============================================================================
MACRO END_ON_ERROR ( "Off" )
MACRO INTERACTIVITY ( "Off" )

DECLARE vParams $1
DECLARE vPwk ""
DECLARE vTemplate ""
DECLARE vStl ""
DECLARE vRun ""
DECLARE vReportDir ""
DECLARE vUser ""
DECLARE vUtc ""
DECLARE vDevice ""
DECLARE vResult ""
DECLARE vJobId ""
DECLARE vApp ""
DECLARE vStlHash ""
DECLARE vProj ""
DECLARE vPiece ""
DECLARE vPieceMade 0
DECLARE vFail ""
DECLARE vNote ""
DECLARE vSt
DECLARE vErr
DECLARE vPlan ""
DECLARE vNs 0
DECLARE vType ""
DECLARE vNd 0
DECLARE vData ""
DECLARE vData2 ""
DECLARE vOptPlay ""
DECLARE vOptLink ""
DECLARE vOptReports ""
DECLARE vOptConfirm ""
DECLARE vOptUi ""
DECLARE vTpls
DECLARE vWantTpl ""
DECLARE vSrcTpl ""
DECLARE vPrev ""
DECLARE vLinked ""
DECLARE vIgn ""
DECLARE vAutoWas ""
DECLARE vPlanSt ""
DECLARE vPlanErr ""
DECLARE vFr ""
DECLARE vNfr 0
DECLARE vPdf ""
DECLARE vI 0
DECLARE vCallId
DECLARE vCheck ""
DECLARE vCheckState ""
DECLARE vCheckMsg ""
DECLARE vSysRoot ""
DECLARE vPs ""
DECLARE vState "ERROR"
DECLARE vMessage ""

DATA_FILE READ LINE_FIELD ( $vParams, 1, 2, vPwk, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 2, 2, vTemplate, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 3, 2, vStl, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 4, 2, vRun, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 5, 2, vReportDir, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 6, 2, vUser, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 7, 2, vUtc, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 8, 2, vDevice, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 9, 2, vResult, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 10, 2, vJobId, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 11, 2, vApp, "=", "On" )
DATA_FILE READ LINE_FIELD ( $vParams, 12, 2, vStlHash, "=", "On" )
MACRO GET_ERROR_STATUS ( vSt, vErr )
IF "$vResult" == ""
    MACRO END ( "Error", "VLC_Evaluate: the parameters file $vParams could not be read." )
ENDIF
SET vPiece "${vTemplate}_${vRun}"
# Windows PowerShell by its full path, never a powershell.exe found first on the search path
SYSTEM ENVIRONMENT_VARIABLE GET ( "SystemRoot", vSysRoot )
SET vPs "${vSysRoot}\System32\WindowsPowerShell\v1.0\powershell.exe"
SYSTEM COMMAND EXEC SYNC ( "IF", { "NOT", "EXIST", "${_QUOTES}${vReportDir}${_QUOTES}", "MKDIR", "${_QUOTES}${vReportDir}${_QUOTES}" } )

# --- 1) the scan is the one VL Connector exported (its SHA-256 was recorded when it was made) --------------
IF "$vStlHash" != ""
    SET vCheck "${vResult}.check"
    DATA_FILE CREATE ( $vCheck, "Ascii", "Yes" )
    SYSTEM COMMAND EXEC SYNC ( $vPs, { "-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-WindowStyle", "Hidden", "-File", "${_QUOTES}${vApp}\polyworks\Test-ScanFile.ps1${_QUOTES}", "-Stl", "${_QUOTES}${vStl}${_QUOTES}", "-Sha256", $vStlHash, "-Out", "${_QUOTES}${vCheck}${_QUOTES}" }, vCallId )
    DATA_FILE READ LINE_FIELD ( $vCheck, 1, 2, vCheckState, "=", "On" )
    DATA_FILE READ LINE_FIELD ( $vCheck, 2, 2, vCheckMsg, "=", "On" )
    SYSTEM COMMAND EXEC SYNC ( "DEL", { "/Q", "${_QUOTES}${vCheck}${_QUOTES}" } )
    IF "$vCheckState" != "OK"
        SET vFail "$vCheckMsg"
        IF "$vFail" == ""
            SET vFail "PowerShell could not run ${vApp}\polyworks\Test-ScanFile.ps1."
        ENDIF
    ENDIF
ENDIF

# --- 2) the template project ------------------------------------------------------------------------
IF "$vFail" == ""
    PROJECT PROPERTIES NAME GET ( vProj )
    IF "$vProj" != "$vTemplate"
        FILE OPEN_PROJECT_IN_PWK ( $vPwk, $vTemplate )
        MACRO GET_ERROR_STATUS ( vSt, vErr )
        IF $vSt == "Error"
            SET vFail "The template $vTemplate could not be opened: $vErr"
        ENDIF
    ENDIF
ENDIF

# --- 3) the source of the new piece -------------------------------------------------------------------
# PolyWorks recommends making new pieces from a piece template (made from the first inspected piece): the
# project property "VL piece template" names it when there are several, otherwise the first one is used.
# Without a piece template the new piece is a copy of the open piece, as PolyWorks' New Piece makes it.
IF "$vFail" == ""
    PIECE PROPERTIES NAME GET ( , vPrev )
    PIECE TEMPLATE NAME ALL GET ( vTpls )
    PROJECT PROPERTIES CUSTOMIZABLE GET ( "VL piece template", vWantTpl )
    IF "$vWantTpl" != ""
        SET vI 1
        WHILE $vI <= SIZE(vTpls)
            IF "$vTpls[$vI]" == "$vWantTpl"
                SET vSrcTpl "$vWantTpl"
            ENDIF
            ++ vI
        ENDWHILE
        IF "$vSrcTpl" == ""
            SET vFail "The template $vTemplate has no piece template $vWantTpl, which its project property 'VL piece template' names."
        ENDIF
    ELSE
        IF SIZE(vTpls) >= 1
            SET vSrcTpl "$vTpls[1]"
        ENDIF
    ENDIF
ENDIF

# --- 4) the new piece -------------------------------------------------------------------------------
# PolyWorks asks about these on a new piece unless they are set; the user's choices are restored at once.
# Unsaved changes of the open piece are saved by PolyWorks first (the Measure button asks before the scan).
IF "$vFail" == ""
    PIECE NEW OPTIONS LAUNCH_PLAY_INSPECTION GET ( vOptPlay )
    PIECE NEW OPTIONS LINK_TO_PIECE_TEMPLATE GET ( vOptLink )
    PIECE NEW OPTIONS NON_UPDATABLE_REPORTS GET ( vOptReports )
    PIECE NEW OPTIONS LAUNCH_PLAY_INSPECTION ( "No" )
    PIECE NEW OPTIONS LINK_TO_PIECE_TEMPLATE ( "No" )
    PIECE NEW OPTIONS NON_UPDATABLE_REPORTS ( "Keep" )
    IF "$vSrcTpl" != ""
        PIECE NEW ( $vPiece, $vSrcTpl )
    ELSE
        PIECE NEW ( $vPiece )
    ENDIF
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF "$vOptPlay" != ""
        PIECE NEW OPTIONS LAUNCH_PLAY_INSPECTION ( $vOptPlay )
    ENDIF
    IF "$vOptLink" != ""
        PIECE NEW OPTIONS LINK_TO_PIECE_TEMPLATE ( $vOptLink )
    ENDIF
    IF "$vOptReports" != ""
        PIECE NEW OPTIONS NON_UPDATABLE_REPORTS ( $vOptReports )
    ENDIF
    IF $vSt == "Error"
        SET vFail "The piece $vPiece could not be added to $vTemplate: $vErr"
    ELSE
        SET vPieceMade 1
    ENDIF
ENDIF

# --- 5) the plan of the new piece: the active measurement sequence and the data object it measures ----
IF "$vFail" == ""
    SEQUENCE ACTIVE GET ( vPlan )
    SET vNs 0
    IF "$vPlan" != ""
        SEQUENCE STEP COUNT GET ( $vPlan, vNs )
    ENDIF
    IF $vNs < 1
        SET vFail "The template $vTemplate has no measurement plan. VL Connector measures with the template's own measurement sequence (Play Inspection): create one in PolyWorks (Sequence Editor, for example from the autogenerated sequence), remove or ignore its step that acquires the data object, and save the template."
    ENDIF
ENDIF
IF "$vFail" == ""
    SET vI 1
    WHILE $vI <= $vNs
        SET vType ""
        SEQUENCE STEP TYPE GET ( $vPlan, $vI, vType )
        IF "$vType" == "Data Object"
            # PolyWorks neither validates nor executes an ignored step
            SET vIgn ""
            SEQUENCE STEP IGNORE GET ( $vPlan, $vI, vIgn )
            IF "$vIgn" != "On"
                SET vFail "The measurement sequence $vPlan of the template $vTemplate acquires data itself (step $vI). VL Connector supplies the scan: remove or ignore that step in the Sequence Editor and save the template."
                SET vI $vNs
            ENDIF
        ENDIF
        ++ vI
    ENDWHILE
ENDIF
IF "$vFail" == ""
    TREEVIEW DATA COUNT GET ( vNd )
    IF $vNd != 1
        SET vFail "The template $vTemplate must have exactly one data object, which receives the scan; it has $vNd."
    ELSE
        TREEVIEW DATA NAME GET ( 1, vData )
    ENDIF
ENDIF
# a new piece without a usable plan is removed again; the source of its plan stays open, to be fixed
IF "$vFail" != "" AND $vPieceMade == 1
    IF "$vSrcTpl" != ""
        PIECE TEMPLATE OPEN ( $vSrcTpl )
    ELSE
        PIECE OPEN ( $vPrev )
    ENDIF
    PIECE DELETE ( { $vPiece } )
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF $vSt != "Error"
        SET vPieceMade 0
    ENDIF
ENDIF

# --- 6) the new piece: linked to its piece template, labelled ---------------------------------------
IF "$vFail" == ""
    # Play Inspection and linking need PolyWorks' automatic project update, which each piece keeps as its own
    # setting: switched on for the new piece when it is off, and switched off again right after the plan
    PROJECT UPDATE AUTO_UPDATE GET ( vAutoWas )
    IF "$vAutoWas" == "Off"
        PROJECT UPDATE AUTO_UPDATE ( "On" )
    ENDIF
    # linked to its piece template, so that PolyWorks can propagate later changes of the plan (tolerances,
    # objects, reports) to the measured pieces; not when the user's PolyWorks option says "No". The option
    # itself does not link a piece made by a macro.
    IF "$vSrcTpl" != "" AND "$vOptLink" != "No"
        # linking stores PolyWorks' choice for reports it cannot update as the user's option: set and restored
        PIECE NEW OPTIONS NON_UPDATABLE_REPORTS ( "Keep" )
        PIECE LINK ( { $vPiece }, $vSrcTpl )
        MACRO GET_ERROR_STATUS ( vSt, vErr )
        IF "$vOptReports" != ""
            PIECE NEW OPTIONS NON_UPDATABLE_REPORTS ( $vOptReports )
        ENDIF
        SET vLinked ""
        PIECE LINKED_TEMPLATE NAME GET ( , vLinked )
        IF "$vLinked" != "$vSrcTpl"
            SET vNote "The piece $vPiece is not linked to the piece template $vSrcTpl: $vErr"
        ENDIF
    ENDIF
    # report header: measurement date and time, serial number, operator, device
    IF "$vUtc" != ""
        PIECE PROPERTIES DATE_TIME_UTC ( , $vUtc )
    ENDIF
    PIECE PROPERTIES CUSTOMIZABLE ( , { "Serial number", "Operator name", "Device" }, { $vPiece, $vUser, $vDevice } )
ENDIF

# --- 7) the scan replaces the data of the plan's data object ----------------------------------------
IF "$vFail" == ""
    DATA REPLACE OPTIONS ALIGNMENT_GROUP CONFIRM_AT_REPLACEMENT GET ( vOptConfirm )
    DATA REPLACE OPTIONS ALIGNMENT_GROUP CONFIRM_AT_REPLACEMENT ( "Off" )
    FILE IMPORT_DATA POLYGONAL_MODEL ( { $vStl }, "stl", $vData )
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF "$vOptConfirm" != ""
        DATA REPLACE OPTIONS ALIGNMENT_GROUP CONFIRM_AT_REPLACEMENT ( $vOptConfirm )
    ENDIF
    IF $vSt == "Error"
        SET vFail "The STL could not be imported into the data object $vData: $vErr"
    ELSE
        # the replaced object takes the name of the file; the plan knows it by its own name
        TREEVIEW DATA NAME GET ( 1, vData2 )
        IF "$vData2" != "$vData"
            TREEVIEW OBJECT PROPERTIES NAME ( $vData, { $vData2 } )
        ENDIF
    ENDIF
ENDIF

# --- 8) the plan: alignment, measurement and report as the template defines them --------------------
IF "$vFail" == ""
    PIECE PLAY_INSPECTION OPTIONS DISABLE_INTERFACE GET ( vOptUi )
    PIECE PLAY_INSPECTION OPTIONS DISABLE_INTERFACE ( "On" )
    PIECE PLAY_INSPECTION
    MACRO GET_ERROR_STATUS ( vPlanSt, vPlanErr )
    IF "$vOptUi" != ""
        PIECE PLAY_INSPECTION OPTIONS DISABLE_INTERFACE ( $vOptUi )
    ENDIF
    TREEVIEW OBJECT SELECT NONE
    IF $vPlanSt == "Error"
        SET vFail "The measurement plan $vPlan of the template $vTemplate failed: $vPlanErr"
    ENDIF
ENDIF
IF "$vAutoWas" == "Off"
    PROJECT UPDATE AUTO_UPDATE ( "Off" )
ENDIF

# --- 9) PDF: the template's own formatted report, updated by the plan -------------------------------
# A template without a formatted report has no PDF; that is no error.
IF "$vFail" == ""
    PROJECT PROPERTIES CUSTOMIZABLE GET ( "VL report", vFr )
    TREEVIEW FORMATTED_REPORT COUNT GET ( vNfr )
    IF "$vFr" == "" AND $vNfr > 0
        TREEVIEW FORMATTED_REPORT NAME GET ( 1, vFr )
    ENDIF
    IF "$vFr" != ""
        SET vPdf "${vReportDir}\${vPiece}.pdf"
        FILE EXPORT_FORMATTED_REPORT PDF ( $vPdf, "Off", $vFr )
        MACRO GET_ERROR_STATUS ( vSt, vErr )
        IF $vSt == "Error"
            SET vFail "The report $vFr could not be exported to PDF: $vErr"
            SET vPdf ""
        ENDIF
    ENDIF
ENDIF

# --- 10) the piece is kept: the project is saved ----------------------------------------------------
IF $vPieceMade == 1
    FILE SAVE_PROJECT
    MACRO GET_ERROR_STATUS ( vSt, vErr )
    IF $vSt == "Error" AND "$vFail" == ""
        SET vFail "The template project could not be saved: $vErr"
    ENDIF
ELSE
    SET vPiece ""
ENDIF

# --- 11) result for the caller ----------------------------------------------------------------------
SET vMessage "$vNote"
IF "$vFail" == ""
    SET vState "OK"
ELSE
    SET vMessage "$vFail"
ENDIF
# PolyWorks' messages can have several lines; the result file has one line per value
IF "$vMessage" != ""
    MACRO STRING REPLACE ( $vMessage, "${_NEWLINE}", " ", , , vMessage )
ENDIF
DATA_FILE CREATE ( $vResult, "Unicode", "Yes" )
DATA_FILE APPEND LINE ( $vResult, { "STATE=$vState" } )
DATA_FILE APPEND LINE ( $vResult, { "PDF=$vPdf" } )
DATA_FILE APPEND LINE ( $vResult, { "PIECE=$vPiece" } )
DATA_FILE APPEND LINE ( $vResult, { "MESSAGE=$vMessage" } )
MACRO ECHO ( "VLC_Evaluate: $vPiece: $vState $vMessage $vPdf" )
IF "$vState" != "OK"
    MACRO END ( "Error", "VLC_Evaluate" )
ENDIF
