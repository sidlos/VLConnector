{
    "about": "Allowed values of every VL Connector setting (lib\\Settings.ps1 checks each layer against it). machineOnly: only defaults.json and the administrator's policy in machine.json may set it; a user file or the machine defaults cannot.",
    "settings": {
        "schema":                  { "type": "int", "min": 1, "max": 1 },
        "scenario":                { "type": "enum", "values": [ "Local", "Network" ] },
        "role":                    { "type": "enum", "values": [ "Scanner", "Station" ] },
        "vl.exe":                  { "type": "path", "machineOnly": true, "about": "The VL Application VL Connector starts when no VL window is open." },
        "vl.args":                 { "type": "string", "maxLength": 1024, "machineOnly": true, "about": "Command line arguments for vl.exe (normally empty)." },
        "vl.programFolders":       { "type": "pathList" },
        "vl.mode":                 { "type": "enum", "values": [ "HighSpeed", "Standard", "Ask" ] },
        "vl.exportImmediately":    { "type": "bool" },
        "vl.confirmStageMotion":   { "type": "bool", "machineOnly": true, "about": "VL Connector answers VL's stage rotation questions with OK itself (warning window and sound)." },
        "vl.afterExport":          { "type": "enum", "values": [ "None", "Minimize", "Close", "SaveAndClose" ] },
        "vl.vldFolder":            { "type": "path" },
        "vl.returnFocus":          { "type": "bool" },
        "vl.timeoutMin":           { "type": "int", "min": 1, "max": 600 },
        "vl.settleSec":            { "type": "number", "min": 0, "max": 60 },
        "vl.closeWaitSec":         { "type": "int", "min": 10, "max": 3600 },
        "vl.menuExportStl":        { "type": "menu", "machineOnly": true, "about": "VL menu path of the STL export (English VL user interface)." },
        "vl.menuSaveAs":           { "type": "menu", "machineOnly": true, "about": "VL menu path of Save As (English VL user interface)." },
        "vl.dialogRules":          { "type": "dialogRules", "machineOnly": true, "actions": [ "ConfirmStageMotion", "ScannerNotConnected" ] },
        "vl.testedVersions":       { "type": "stringList", "machineOnly": true, "about": "VL versions whose stage questions VL Connector knows." },
        "polyworks.keepPieces":    { "type": "enum", "values": [ "All", "Nok", "None" ] },
        "polyworks.openPdf":       { "type": "bool" },
        "polyworks.colorScaleMm":  { "type": "number", "min": 0.001, "max": 100 },
        "polyworks.reportsFolder": { "type": "path" },
        "polyworks.scansFolder":   { "type": "path" },
        "polyworks.deviceText":    { "type": "string", "maxLength": 200 },
        "polyworks.operatorName":  { "type": "string", "maxLength": 100 },
        "network.share":           { "type": "path" },
        "network.autoOpenReports": { "type": "bool" },
        "network.stationName":     { "type": "string", "maxLength": 60 },
        "network.pollSec":         { "type": "int", "min": 1, "max": 300 },
        "network.jobTimeoutMin":   { "type": "int", "min": 1, "max": 1440 },
        "safety.stageWarningSec":  { "type": "int", "min": 2, "max": 30, "machineOnly": true, "about": "How long the warning window stays after an automatic stage confirmation." },
        "safety.stageSound":       { "type": "bool", "machineOnly": true, "about": "Sound with the warning window." },
        "safety.watchAllowClose":  { "type": "bool", "machineOnly": true, "about": "The agent (watch mode) may close VL after the export." }
    }
}
