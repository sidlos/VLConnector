<!--
  VL Connector for PolyWorks - settings window. Loaded by app\ui\SettingsForm.ps1, which fills in
  the values and connects the events. Every change is saved straight away (no Save button).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VL Connector for PolyWorks" Width="1100" Height="740" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="14,16,10,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,22">
                <Image x:Name="AppIcon" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="VL Connector" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="for PolyWorks" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <RadioButton x:Name="NavAbout" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About"/>
            </StackPanel>
            <StackPanel>
                <RadioButton x:Name="NavSetup" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Setup" IsChecked="True"/>
                <RadioButton x:Name="NavScanning" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE722;" Content="Scanning"/>
                <RadioButton x:Name="NavPolyWorks" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE8A5;" Content="PolyWorks"/>
                <RadioButton x:Name="NavNetwork" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE774;" Content="Network"/>
                <RadioButton x:Name="NavDiagnostics" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Diagnostics"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8,0,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,0,0">
            <Grid>
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="40,30,40,36" MaxWidth="940" HorizontalAlignment="Stretch">

                        <!-- ===== Setup ===== -->
                        <StackPanel x:Name="PageSetup">
                            <DockPanel>
                                <Button x:Name="RunWizard" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Setup wizard" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Setup" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="Choose how VL and PolyWorks work together on this PC." Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,8"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Scenario" Style="{StaticResource SectionText}"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="ScenarioLocal" GroupName="Scenario" Style="{StaticResource ChoiceCard}" Margin="0,0,6,0">
                                    <StackPanel Margin="0,0,26,0">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#E0EEF9" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="20"/>
                                        </Border>
                                        <TextBlock Text="PolyWorks on this PC" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBlock Style="{StaticResource CaptionText}" FontSize="13"
                                                   Text="VL and PolyWorks run on this computer. The Measure button in PolyWorks starts the scan, evaluates it and creates the report."/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ScenarioNetwork" GroupName="Scenario" Style="{StaticResource ChoiceCard}" Margin="6,0,0,0">
                                    <StackPanel Margin="0,0,26,0">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#E0EEF9" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="20"/>
                                        </Border>
                                        <TextBlock Text="PolyWorks on another PC" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                        <TextBlock Style="{StaticResource CaptionText}" FontSize="13"
                                                   Text="Scans go to a shared network folder. A PolyWorks station evaluates them and the PDF report comes back to this PC."/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <Border x:Name="RoleCard" Style="{StaticResource Card}" Margin="0,8,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7EE;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="This PC is" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="The scanner PC starts scans. The PolyWorks station evaluates them." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RoleScanner" GroupName="Role" Style="{StaticResource Segment}" Content="Scanner PC" IsChecked="True"/>
                                            <RadioButton x:Name="RoleStation" GroupName="Role" Style="{StaticResource Segment}" Content="PolyWorks station"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="Status" Style="{StaticResource SectionText}"/>
                            <ItemsControl x:Name="StatusList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Back}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                               Foreground="{Binding Fore}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="{Binding Action}" Tag="{Binding Id}" Visibility="{Binding ActionVisibility}"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ===== Scanning ===== -->
                        <StackPanel x:Name="PageScanning" Visibility="Collapsed">
                            <TextBlock Text="Scanning" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="How AI Replay runs in VL and what happens after the STL export." Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,8"/>

                            <TextBlock Text="AI Replay" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE768;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Replay mode" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="High speed is faster. Standard lets you confirm the stitching. 'Ask' leaves the choice to the operator in VL." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ModeHighSpeed" GroupName="Mode" Style="{StaticResource Segment}" Content="High speed"/>
                                            <RadioButton x:Name="ModeStandard" GroupName="Mode" Style="{StaticResource Segment}" Content="Standard"/>
                                            <RadioButton x:Name="ModeAsk" GroupName="Mode" Style="{StaticResource Segment}" Content="Ask operator"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE916;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Export the STL right after the scan" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="About 20 s faster. The STL stays in scanner coordinates and PolyWorks pre-aligns it automatically. Can be overridden per template ('VL options')." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ExportImmediately" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7AD;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Confirm stage movement automatically" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="Answers 'The stage will rotate. Continue?' and 'Return the stage to the origin?' with OK." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ConfirmStage" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border x:Name="StageWarning" Style="{StaticResource WarningBar}">
                                <DockPanel>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" DockPanel.Dock="Left" Foreground="{StaticResource WarningBrush}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                               Text="The stage then moves without asking. Make sure nothing blocks the stage and nobody reaches into the scanner."/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="After the STL export" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE737;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="VL window" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="Closing keeps VL windows from piling up. VL is closed only after the STL file has been checked." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="AfterExport" Grid.Column="2" Width="290" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Leave VL open" Tag="None"/>
                                        <ComboBoxItem Content="Minimize VL" Tag="Minimize"/>
                                        <ComboBoxItem Content="Close VL without saving" Tag="Close"/>
                                        <ComboBoxItem Content="Save VL data (.vld4), then close" Tag="SaveAndClose"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border x:Name="VldFolderCard" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Folder for VL data" Style="{StaticResource BodyText}"/>
                                        <TextBox x:Name="VldFolder" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="VldFolderBrowse" Grid.Column="2" Content="Browse" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Bring the evaluation to the front" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="After the export the PolyWorks (or VL Connector) window comes to the front." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ReturnFocus" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Programs" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Folder with VL programs (.vld4)" Style="{StaticResource BodyText}"/>
                                        <TextBox x:Name="ProgramFolder" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="ProgramFolderBrowse" Grid.Column="2" Content="Browse" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== PolyWorks ===== -->
                        <StackPanel x:Name="PagePolyWorks" Visibility="Collapsed">
                            <TextBlock Text="PolyWorks" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="Report, measured pieces and the Measure button." Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,8"/>

                            <TextBlock Text="Report" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Report layouts" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="A4 report with a large color map and a green OK or red NOK verdict, built from your PolyWorks installation." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <Border x:Name="LayoutPill" Grid.Column="2" Style="{StaticResource Pill}" Background="{StaticResource SuccessBackBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="LayoutPillText" Text="Ready" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                    <Button x:Name="GenerateLayouts" Grid.Column="3" Content="Generate" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Keep measured pieces" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="Saved pieces can be reopened in PolyWorks later. The PDF and CSV are always kept." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="KeepPieces" Grid.Column="2" Width="240" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Every piece" Tag="All"/>
                                        <ComboBoxItem Content="Only NOK pieces" Tag="Nok"/>
                                        <ComboBoxItem Content="None (PDF and CSV only)" Tag="None"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Open the PDF report after the evaluation" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="Opens in your default PDF viewer." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="OpenPdf" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Measure button" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <TextBlock Text="Add the Measure button to the PolyWorks ribbon (once per user)" Style="{StaticResource BodyText}"/>
                                            <Border x:Name="ButtonPill" Style="{StaticResource Pill}" HorizontalAlignment="Right" Background="{StaticResource WarningBackBrush}">
                                                <TextBlock x:Name="ButtonPillText" Text="Not imported yet" FontSize="12" Foreground="{StaticResource WarningBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="Open PolyWorks|Inspector (any project) and press Add to PolyWorks: a ribbon tab 'VL Connector' with the button appears. Your PolyWorks layout is saved first."/>
                                        <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="By hand instead: File > Visual Layout > Customize > Customize, tab Macro Scripts > Import the macro (Copy macro path), then add it to the ribbon."/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="AddToPolyWorks" Style="{StaticResource AccentButton}" Content="Add to PolyWorks"/>
                                            <Button x:Name="CopyMacroPath" Content="Copy macro path" Margin="8,0,0,0"/>
                                            <Button x:Name="CopyIconPath" Content="Copy icon path" Margin="8,0,0,0"/>
                                            <Button x:Name="ButtonHelp" Style="{StaticResource SubtleButton}" Content="Step-by-step guide" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource InfoBar}">
                                <DockPanel>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" DockPanel.Dock="Left" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                               Text="Each part template needs the project property 'VL program' (File > Project > Properties > Add)."/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Network ===== -->
                        <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
                            <TextBlock Text="Network" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="Shared folder between the scanner PC and the PolyWorks station." Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,8"/>

                            <TextBlock Text="Shared folder" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8CE;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Network path (UNC), for example \\fileserver\metrology\VLConnector" Style="{StaticResource BodyText}"/>
                                        <TextBox x:Name="SharePath" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ShareStatus" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,22">
                                        <Button x:Name="ShareBrowse" Content="Browse"/>
                                        <Button x:Name="ShareTest" Style="{StaticResource AccentButton}" Content="Test" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Open my PDF reports automatically" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="Only reports of scans made on this PC are opened." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoOpenReports" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Agent (scanner PC)" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Start the agent with Windows" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="The agent waits in the notification area. After each AI Replay in VL it exports the STL, sends it to the PolyWorks station and opens the report." Style="{StaticResource CaptionText}"/>
                                        <TextBlock x:Name="AgentStatus" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="StartAgent" Content="Start now" Margin="0,0,14,0"/>
                                        <CheckBox x:Name="AgentAutostart" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Programs" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Programs list" Style="{StaticResource BodyText}"/>
                                        <TextBlock x:Name="ProgramsSummary" Text="Which PolyWorks template evaluates the scans of each VL program (.vld4)." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <Button x:Name="EditPrograms" Grid.Column="2" Content="Edit list" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== Diagnostics ===== -->
                        <StackPanel x:Name="PageDiagnostics" Visibility="Collapsed">
                            <TextBlock Text="Diagnostics" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="Logs and versions for support." Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,8"/>
                            <TextBlock Text="Logs" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9F9;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Log files" Style="{StaticResource BodyText}"/>
                                        <TextBlock x:Name="LogFolder" Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <Button x:Name="OpenLogs" Grid.Column="2" Content="Open folder" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource IconText}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Collect diagnostics" Style="{StaticResource BodyText}"/>
                                        <TextBlock Text="Creates a ZIP with logs, settings and the status check on your desktop. No scans or reports are included." Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                    <Button x:Name="CollectDiagnostics" Style="{StaticResource AccentButton}" Grid.Column="2" Content="Create ZIP" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Versions" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <TextBlock x:Name="Versions" Style="{StaticResource BodyText}" FontFamily="Consolas, Cascadia Mono" FontSize="13" LineHeight="21"/>
                            </Border>
                        </StackPanel>

                        <!-- ===== About ===== -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <TextBlock Text="About" Style="{StaticResource TitleText}"/>
                            <Border Style="{StaticResource Card}" Margin="0,18,0,4" Padding="22,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="AboutIcon" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="VL Connector for PolyWorks" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutVersion" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"/>
                                        <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,2,0,0"
                                                   Text="Connects KEYENCE VL-800 AI Replay scans with PolyWorks|Inspector evaluation and reports."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource WarningBar}">
                                <DockPanel>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" DockPanel.Dock="Left" Foreground="{StaticResource WarningBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                               Text="Unofficial tool. It is not an official KEYENCE or InnovMetric product and is not covered by their warranty or support. KEYENCE, VL-800 and PolyWorks are trademarks of their respective owners."/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Support" Style="{StaticResource SectionText}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource IconText}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                               Text="Contact your local sales engineer, who forwards questions to the local technical team."/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Documents" Style="{StaticResource SectionText}"/>
                            <WrapPanel>
                                <Button x:Name="OpenGuide" Style="{StaticResource AccentButton}" Content="User guide" Margin="0,0,8,8"/>
                                <Button x:Name="OpenItReview" Content="Notes for IT" Margin="0,0,8,8"/>
                                <Button x:Name="OpenLicense" Content="License (MIT)" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- "Saved" toast -->
                <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,8"
                        CornerRadius="6" Background="#323232" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="#9FE39A" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToastText" Text="Saved" Foreground="White" FontSize="13" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
