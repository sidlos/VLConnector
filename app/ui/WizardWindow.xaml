<!--
  VL Connector for PolyWorks - setup wizard. Loaded by app\ui\WizardForm.ps1, which fills in the values,
  shows the steps that fit the chosen scenario and connects the events.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VL Connector - Setup" Width="860" Height="680" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header with the steps -->
        <DockPanel Grid.Row="0" Margin="32,24,32,8">
            <Image x:Name="AppIcon" Width="36" Height="36" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Set up VL Connector" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="StepText" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,8,32,16">

                <!-- 1. scenario -->
                <StackPanel x:Name="PageScenario">
                    <TextBlock Text="How do VL and PolyWorks work together here?" Style="{StaticResource SectionText}" Margin="0,8,0,10"/>
                    <RadioButton x:Name="ChooseLocal" GroupName="Scenario" Style="{StaticResource ChoiceCard}" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="PolyWorks on this PC" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"
                                       Text="VL and PolyWorks run on this computer. The Measure button in PolyWorks starts AI Replay in VL, evaluates the scan and creates the report."/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChooseScanner" GroupName="Scenario" Style="{StaticResource ChoiceCard}" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="Scanner PC - PolyWorks is on another PC" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"
                                       Text="Operators scan with AI Replay in VL as usual. The VL Connector agent exports the STL, sends it to a shared network folder and opens the PDF report when it comes back."/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChooseStation" GroupName="Scenario" Style="{StaticResource ChoiceCard}">
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="PolyWorks station for the scanner PCs" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,4,0,0"
                                       Text="This PC has PolyWorks. It takes the scans from the shared folder, evaluates them with the template of each VL program and sends the reports back."/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 2. scanning -->
                <StackPanel x:Name="PageScanning" Visibility="Collapsed">
                    <Border x:Name="VlBar" Style="{StaticResource InfoBar}" Margin="0,8,0,8">
                        <DockPanel>
                            <Button x:Name="LocateVl" DockPanel.Dock="Right" Content="Locate" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="VlText" Style="{StaticResource BodyText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="AI Replay mode" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="High speed is faster. Standard lets you confirm the stitching. 'Ask' leaves the choice to the operator in VL." Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ModeHighSpeed" GroupName="Mode" Style="{StaticResource Segment}" Content="High speed"/>
                                    <RadioButton x:Name="ModeStandard" GroupName="Mode" Style="{StaticResource Segment}" Content="Standard"/>
                                    <RadioButton x:Name="ModeAsk" GroupName="Mode" Style="{StaticResource Segment}" Content="Ask operator"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Export the STL right after the scan" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="About 20 s faster. PolyWorks aligns the scan to the CAD automatically." Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <CheckBox x:Name="ExportImmediately" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Confirm stage movement automatically" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="Answers 'The stage will rotate. Continue?' with OK. The stage then moves without asking." Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <CheckBox x:Name="ConfirmStage" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="VL window after the export" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="Closing keeps VL windows from piling up. VL is closed only after the STL has been checked." Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <ComboBox x:Name="AfterExport" Grid.Column="1" Width="270" VerticalAlignment="Center">
                                <ComboBoxItem Content="Leave VL open" Tag="None"/>
                                <ComboBoxItem Content="Minimize VL" Tag="Minimize"/>
                                <ComboBoxItem Content="Close VL without saving" Tag="Close"/>
                                <ComboBoxItem Content="Save VL data (.vld4), then close" Tag="SaveAndClose"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 3a. PolyWorks -->
                <StackPanel x:Name="PagePolyWorks" Visibility="Collapsed">
                    <Border x:Name="PwBar" Style="{StaticResource InfoBar}" Margin="0,8,0,8">
                        <TextBlock x:Name="PwText" Style="{StaticResource BodyText}" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="TabTitle" Text="VL Connector tab in PolyWorks" Style="{StaticResource BodyText}"/>
                                <TextBlock x:Name="TabText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="Adds a ribbon tab 'VL Connector' with the button to PolyWorks|Inspector. Open PolyWorks|Inspector first (any project). Your current PolyWorks layout is saved before, so this can be undone."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UndoTab" Content="Undo" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <Button x:Name="AddTab" Style="{StaticResource AccentButton}" Content="Add to PolyWorks"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Report layouts" Style="{StaticResource BodyText}"/>
                                <TextBlock x:Name="LayoutsText" Style="{StaticResource CaptionText}" Text="A4 report with a large color map and a green OK or red NOK verdict."/>
                            </StackPanel>
                            <Button x:Name="BuildLayouts" Grid.Column="1" Content="Build" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Keep measured pieces" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="The PDF and CSV are always kept." Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <ComboBox x:Name="KeepPieces" Grid.Column="1" Width="230" VerticalAlignment="Center">
                                <ComboBoxItem Content="Every piece" Tag="All"/>
                                <ComboBoxItem Content="Only NOK pieces" Tag="Nok"/>
                                <ComboBoxItem Content="None (PDF and CSV only)" Tag="None"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border x:Name="PropertyHint" Style="{StaticResource InfoBar}">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="13" TextWrapping="Wrap"
                                   Text="Each part template needs the project property 'VL program' with the path to its .vld4 (File > Project > Properties > Add)."/>
                    </Border>
                </StackPanel>

                <!-- 3b. network -->
                <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Shared network folder" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="For example \\fileserver\metrology\VLConnector. Scanner PCs and the station must be able to write to it." Style="{StaticResource CaptionText}"/>
                                <TextBox x:Name="SharePath" Margin="0,8,0,0"/>
                                <TextBlock x:Name="ShareStatus" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,20">
                                <Button x:Name="ShareBrowse" Content="Browse"/>
                                <Button x:Name="ShareTest" Style="{StaticResource AccentButton}" Content="Test" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="AgentCard" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Start the VL Connector agent with Windows" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="It waits in the notification area. After each AI Replay it exports the STL, sends it to the station and opens the report." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="AgentAutostart" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="AutoOpenCard" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Open my PDF reports automatically" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="Only reports of scans made on this PC are opened." Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoOpenReports" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ProgramsCard" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Programs list" Style="{StaticResource BodyText}"/>
                                <TextBlock x:Name="ProgramsText" Text="Which PolyWorks template evaluates the scans of each VL program (.vld4)." Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="EditPrograms" Grid.Column="1" Content="Edit list" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 4. done -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed">
                    <Border Style="{StaticResource SuccessBar}" Margin="0,8,0,12">
                        <TextBlock Text="VL Connector is set up." Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                    </Border>
                    <ItemsControl x:Name="Summary">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,4">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SuccessBrush}" Margin="0,3,10,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NextText" Style="{StaticResource CaptionText}" FontSize="13" Margin="4,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- footer -->
        <Border Grid.Row="2" Background="{StaticResource PaneBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <DockPanel>
                <Button x:Name="CancelButton" Style="{StaticResource SubtleButton}" Content="Cancel" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" MinWidth="96"/>
                    <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Next" MinWidth="110" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
